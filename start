<!DOCTYPE html>
<html>
<head>
    <title>Meine erste Webseite</title>

    <style>
        body {
            background-color: lightblue;
            font-family: Arial;
            text-align: center;
            padding-top: 100px;
        }

        h1 {
            color: darkblue;
        }

        p {
            font-size: 20px;
        }

        button {
            background-color: darkblue;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 18px;
        }

        button:hover {
            background-color: blue;
        }
    </style>
</head>

<body>

    <h1>Meine erste Webseite 🚀</h1>

    <p id="nachricht">Klicke auf den Button!</p>

    <button onclick="hallo()">Drück mich!</button>

    <script>
        function hallo() {
            document.body.style.backgroundColor = "red" ; getElementById("nachricht").innerHTML =
                "du pimmel 🎉";
        }
    </script>

</body>
</html>

